@* The Viewer's one page: toolbar, Action list and the State and Diff tabs for the selected Session, kept up to date from the registry. *@
@page "/"
@implements IAsyncDisposable
@inject SessionRegistry Registry
@inject IJSRuntime JS
@inject TimeProvider Time

<PageTitle>Fluxor Viewer</PageTitle>

<div class="flex h-screen flex-col">
    <header class="flex flex-wrap items-center gap-4 border-b border-zinc-200 px-4 py-2 dark:border-zinc-800">
        <SessionPicker Sessions="sessions" Selected="selection.Selected" SelectedChanged="Select"
                       ForgottenBeyond="Registry.ForgottenBeyond" />
        <FeaturePicker Features="features.Features" HasSession="FeatureSession is not null"
                       Selected="@features.Selected" SelectedChanged="SelectFeature" />
        <ClearButton Session="SelectedSession" Cleared="Clear" />
        <ClearDisconnectedButton Sessions="sessions" Cleared="ClearDisconnected" />
    </header>

    @if (sessions.Count == 0)
    {
        <Waiting />
    }
    else if (!picksLoaded)
    {
        @* UI-13: the Action list's dimming and the tabs depend on the Feature, so they wait for the stored picks too. *@
        <main class="flex-1"></main>
    }
    else
    {
        <main class="flex min-h-0 flex-1">
            <section class="flex min-h-0 w-96 shrink-0 flex-col border-r border-zinc-200 dark:border-zinc-800">
                @if (selection.Selected is null)
                {
                    <div class="pane"><PickASession /></div>
                }
                else
                {
                    <ActionListPane List="actions" HasFeature="features.Selected is not null" SelectedChanged="StateHasChanged"
                                    DiscardedBeyond="SelectedSession?.DiscardedBeyond" />
                }
            </section>
            <section class="flex min-h-0 min-w-0 flex-1 flex-col">
                @if (selection.Selected is null)
                {
                    <div class="pane"><PickASession /></div>
                }
                else
                {
                    @if (actions.Selected is ActionEntry action)
                    {
                        <PayloadStrip Action="action" @bind-Expanded="pane.PayloadExpanded" Toggles="pane.PayloadChoices.For(action.ActionType)" />
                    }
                    <div class="flex gap-1 border-b border-zinc-200 px-4 dark:border-zinc-800" role="tablist" aria-label="Right pane" data-test="tabs">
                        @foreach (var tab in Enum.GetValues<RightTab>())
                        {
                            var selected = tab == pane.Tab;
                            <button class="-mb-px border-b-2 px-3 py-2 text-sm @(selected ? "border-sky-600 text-zinc-900 dark:border-sky-400 dark:text-zinc-100" : "border-transparent text-zinc-500 hover:text-zinc-900 dark:text-zinc-400 dark:hover:text-zinc-100")"
                                    role="tab" aria-selected="@(selected ? "true" : "false")" data-test="tab" @onclick="() => pane.Tab = tab">@tab</button>
                        }
                    </div>
                    <div class="pane flex-1" role="tabpanel" aria-label="@pane.Tab">
                        @if (pane.Tab == RightTab.Diff)
                        {
                            <DiffPane Feature="@features.Selected" Entry="actions.Selected" @bind-ShowUnchanged="pane.ShowUnchanged" />
                        }
                        else
                        {
                            <StatePane Feature="@features.Selected" Entry="actions.Selected" Current="SelectedSession?.Current ?? []"
                                       Toggles="pane.StateChoices.For(features.Selected)" />
                        }
                    </div>
                }
            </section>
        </main>
    }
</div>

@code {
    private readonly SessionSelection selection = new();
    private readonly FeatureSelection features = new();
    private readonly ActionList actions = new();
    private IReadOnlyList<ReceivedSession> sessions = [];
    private readonly RightPaneState pane = new();
    private RenderThrottle? throttle;
    private CollocatedModule module = default!;

    private bool picksLoaded;

    protected override void OnInitialized()
    {
        module = new(JS, "./Components/Pages/Home.razor.js");
        Refresh();
        // A burst of Actions re-reads and renders about 10 times a second, not once per batch.
        throttle = new RenderThrottle(Time, TimeSpan.FromMilliseconds(100), () => _ = InvokeAsync(() =>
        {
            Refresh();
            StateHasChanged();
        }));
        Registry.Changed += OnChanged;
    }

    // UI-13: the browser's stored Feature picks can only be read once the page is rendered.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;
        features.Restore(await LoadFeaturePicksAsync());
        picksLoaded = true;
        UpdateSelectedSession();
        StateHasChanged();
    }

    // Without the stored picks the tab still keeps its own picks in memory, as before UI-13.
    private async Task<IReadOnlyDictionary<string, string>> LoadFeaturePicksAsync()
    {
        try
        {
            return await module.InvokeAsync<Dictionary<string, string>>("loadFeaturePicks");
        }
        catch (Exception e) when (e is JSException or TaskCanceledException or JSDisconnectedException)
        {
            // TaskCanceledException is the interop timeout, e.g. a module import that never finishes.
            return new Dictionary<string, string>();
        }
    }

    private void OnChanged(SessionChange change)
    {
        // Actions in other Sessions don't matter here. For the selected one they're re-read: a Snapshot for a
        // still-connected Session raises no change of its own, and may have brought a different set of Features.
        // Reading the selection off the render thread is safe: switching Session re-reads the registry itself, so an
        // Action skipped here for a Session that was just being selected is still shown.
        if (change is EntriesAppended && change.SessionId != selection.Selected)
            return;
        throttle?.Request();
    }

    private void Refresh()
    {
        sessions = Registry.GetSessions();
        selection.Update(sessions);
        UpdateSelectedSession();
    }

    private void Select(Guid sessionId)
    {
        selection.Select(sessionId);
        selection.Update(sessions);
        UpdateSelectedSession();
    }

    // Re-read at once rather than waiting for the throttled SessionCleared, so the Clear shows without a delay here.
    private void Clear(Guid sessionId)
    {
        Registry.Clear(sessionId);
        Refresh();
    }

    // Re-read at once, as for Clear.
    private void ClearDisconnected()
    {
        Registry.ClearDisconnected();
        Refresh();
    }

    private async Task SelectFeature(string featureName)
    {
        if (SelectedSession is not { } session)
            return;
        features.Select(session.AppName, featureName);
        UpdateSelectedSession();
        await SaveFeaturePickAsync(session.AppName, featureName);
    }

    // A pick that can't be stored is still kept in memory for this Viewer tab.
    private async Task SaveFeaturePickAsync(string appName, string featureName)
    {
        try
        {
            await module.InvokeVoidAsync("saveFeaturePick", appName, featureName);
        }
        catch (JSException)
        {
        }
    }

    private ReceivedSession? SelectedSession => sessions.FirstOrDefault(s => s.SessionId == selection.Selected);

    // UI-13: the Session whose Features can be chosen from; none until the stored picks are loaded, so the first Feature
    // never shows only to be replaced.
    private ReceivedSession? FeatureSession => picksLoaded ? SelectedSession : null;

    /// <summary>Re-reads what depends on the selected Session: its Features, then its Actions against the Feature.</summary>
    private void UpdateSelectedSession()
    {
        features.Update(FeatureSession?.AppName, FeatureSession?.Current.Keys ?? []);
        actions.Update(SelectedSession, features.Selected);
    }

    /// <summary>Stops listening to the registry and releases the page's JS module.</summary>
    public async ValueTask DisposeAsync()
    {
        Registry.Changed -= OnChanged;
        throttle?.Dispose();
        await module.DisposeAsync();
    }
}
