<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- PK-4: packed by tools/pack.sh as the fluxor-viewer tool, installed from the local feed. -->
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackAsTool>true</PackAsTool>
    <PackageId>fluxor-viewer</PackageId>
    <ToolCommandName>fluxor-viewer</ToolCommandName>
    <Description>The Fluxor Viewer: inspect the Actions and Feature states a Fluxor app reports, in real time.</Description>
  </PropertyGroup>

  <!-- The Web SDK publishes every .json file; the npm ones only build the CSS. -->
  <ItemGroup>
    <Content Update="package.json;package-lock.json" CopyToPublishDirectory="Never" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FluxorViewer.Protocol\FluxorViewer.Protocol.csproj" />
  </ItemGroup>

  <!--
    Tailwind: Styles/app.css is built into wwwroot/app.css (gitignored) before every build that needs it.
    Requires Node; installed tools ship the built CSS. During development, `npm run watch` rebuilds on .razor edits
    that hot reload applies without a build.
  -->
  <PropertyGroup>
    <TailwindInput>Styles/app.css</TailwindInput>
    <TailwindOutput>wwwroot/app.css</TailwindOutput>
  </PropertyGroup>

  <ItemGroup>
    <TailwindSource Include="Components/**/*.razor;Styles/**/*.css" />
    <UpToDateCheckInput Include="@(TailwindSource)" />
  </ItemGroup>

  <Target Name="NpmInstall" Inputs="package.json;package-lock.json" Outputs="node_modules/.package-lock.json">
    <Exec Command="npm ci --no-fund --no-audit" />
  </Target>

  <Target Name="Tailwind" DependsOnTargets="NpmInstall" BeforeTargets="BeforeBuild"
          Inputs="@(TailwindSource);package-lock.json" Outputs="$(TailwindOutput)">
    <Exec Command="npm run build --silent" />
    <!--
      On a clean build the file didn't exist when wwwroot was globbed, so add it for static web assets. Removed by full
      path: a Remove inside a target matches item specs as strings, so on Windows wwwroot/app.css misses the globbed
      wwwroot\app.css and the file ends up in Content twice.
    -->
    <ItemGroup>
      <Content Remove="@(Content)" Condition="'%(FullPath)' == '$([MSBuild]::NormalizePath($(MSBuildProjectDirectory), $(TailwindOutput)))'" />
      <Content Include="$(TailwindOutput)" />
    </ItemGroup>
  </Target>

  <!--
    jsondiffpatch (the Diff tab) is copied from node_modules into wwwroot/lib (gitignored) so the tool works offline.
    with-text-diffs.js is left out: it needs diff-match-patch, and strings aren't diffed character by character.
  -->
  <Target Name="JsonDiffPatch" DependsOnTargets="NpmInstall" BeforeTargets="BeforeBuild">
    <ItemGroup>
      <JsonDiffPatchFile Include="node_modules/jsondiffpatch/lib/**/*.js" Exclude="node_modules/jsondiffpatch/lib/with-text-diffs.js" />
    </ItemGroup>
    <Copy SourceFiles="@(JsonDiffPatchFile)" SkipUnchangedFiles="true"
          DestinationFiles="@(JsonDiffPatchFile->'wwwroot/lib/jsondiffpatch/%(RecursiveDir)%(Filename)%(Extension)')" />
    <!-- As for app.css: on a clean build these didn't exist when wwwroot was globbed, and removed by full path. -->
    <ItemGroup>
      <Content Remove="@(Content)" Condition="$([System.String]::Copy('%(FullPath)').StartsWith('$([MSBuild]::NormalizeDirectory($(MSBuildProjectDirectory), wwwroot, lib, jsondiffpatch))'))" />
      <Content Include="wwwroot/lib/jsondiffpatch/**" />
    </ItemGroup>
  </Target>

</Project>
