@using System.Globalization
@using Microsoft.AspNetCore.Components.Web.Virtualization
@implements IAsyncDisposable
@inject IJSRuntime JS

<div class="flex items-center gap-3 border-b border-zinc-200 px-3 py-2 dark:border-zinc-800">
    <input class="control min-w-0 flex-1" type="search" placeholder="filter…" aria-label="Filter by Action type"
           data-test="action-filter" value="@List.Filter" @oninput="OnFilter" />
    <label class="flex shrink-0 items-center gap-1.5 text-sm" title="Hide Actions that didn't change the selected Feature">
        <input type="checkbox" data-test="changed-only" checked="@List.ChangedOnly" disabled="@(!HasFeature)"
               @onchange="OnChangedOnly" />
        changed only
    </label>
</div>

@* Not a row: the filter, "changed only" and Follow mode never see it. *@
@if (DiscardedBeyond is { } limit)
{
    <p class="muted border-b border-zinc-200 px-3 py-1 text-xs dark:border-zinc-800" data-test="discarded">
        Older entries discarded · the Viewer keeps the last @limit.Value.ToString("#,0", CultureInfo.InvariantCulture) per Session
    </p>
}

@* The messages are about Actions only; Resync rows still show beneath them. *@
@if (List.ActionCount == 0)
{
    <p class="muted p-4" data-test="no-actions">No Actions yet</p>
}
else if (List.VisibleActionCount == 0)
{
    <p class="muted p-4" data-test="no-match">
        No Actions match.
        <button class="underline" data-test="show-all" @onclick="ShowAll">Show all</button>
    </p>
}
@if (List.Rows.Length > 0)
{
    <div class="relative min-h-0 flex-1">
        <div class="h-full overflow-auto" role="listbox" aria-label="Actions" data-test="action-list" @ref="scroller">
            @* Fixed row height (h-7 = 28px) keeps virtualisation exact. *@
            <Virtualize Items="List.Rows" ItemSize="28" Context="row">
                @{
                    var selected = row.Entry.Id == List.Selected?.Id;
                    var dimmed = row is ActionRow { Dimmed: true };
                    var local = row.At.ToLocalTime();
                }
                <div class="action-row @(selected ? "action-row-selected" : "") @(dimmed ? "opacity-45" : "")"
                     role="option" aria-selected="@(selected ? "true" : "false")" data-dimmed="@(dimmed ? "true" : "false")"
                     data-test="@(row is ResyncRow ? "resync-row" : "action-row")" @key="row.Entry.Id" @onclick="() => Select(row.Entry.Id)">
                    @switch (row)
                    {
                        case ActionRow actionRow:
                            <span class="w-12 shrink-0 text-right text-zinc-500 tabular-nums" data-test="sequence">@actionRow.Action.Sequence</span>
                            <span class="min-w-0 flex-1 truncate font-mono" data-test="type" title="@actionRow.Action.ActionType">@actionRow.ShortName</span>
                            break;
                        case ResyncRow resyncRow:
                            <span class="w-12 shrink-0"></span>
                            <span class="min-w-0 flex-1 truncate text-amber-700 dark:text-amber-400" data-test="resync"
                                  title="@resyncRow.LostRange">@resyncRow.Label</span>
                            break;
                    }
                    <span class="shrink-0 text-zinc-500 tabular-nums" data-test="time"
                          title="@local.ToString("yyyy-MM-dd HH:mm:ss.fff zzz")">@local.ToString("HH:mm:ss.fff")</span>
                </div>
            </Virtualize>
        </div>
        @if (List.NewCount > 0)
        {
            <button class="absolute right-3 bottom-3 rounded-full bg-sky-600 px-3 py-1 text-sm text-white shadow-md hover:bg-sky-700 dark:bg-sky-500 dark:hover:bg-sky-400"
                    data-test="new-actions" @onclick="Resume">▼ @List.NewCount new</button>
        }
    </div>
}

@code {
    /// <summary>The tab's list state; <see cref="Home"/> updates it from the registry.</summary>
    [Parameter, EditorRequired] public ActionList List { get; set; } = default!;

    /// <summary>Whether a Feature is selected; without one, "changed only" has nothing to compare against.</summary>
    [Parameter] public bool HasFeature { get; set; }

    /// <summary>The History limit, once the Session has discarded older entries to stay within it; otherwise null.</summary>
    [Parameter] public HistoryLimit? DiscardedBeyond { get; set; }

    /// <summary>
    /// Raised after <see cref="List"/>'s selection may have changed: the developer selected a row or resumed Follow mode,
    /// or changed the filter or toggle while following.
    /// </summary>
    [Parameter] public EventCallback SelectedChanged { get; set; }

    private ElementReference scroller;
    private IJSObjectReference? module;

    // The newest row the list last scrolled to while following; null while paused, so resuming scrolls again.
    private HistoryEntry? scrolledTo;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        var newest = List.Following && List.Rows is [.., var last] ? last.Entry : null;
        if (ReferenceEquals(newest, scrolledTo))
            return;
        scrolledTo = newest;
        if (newest is null)
            return;
        module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./Components/ActionListPane.razor.js");
        await module.InvokeVoidAsync("scrollToBottom", scroller);
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            if (module is not null)
                await module.DisposeAsync();
        }
        catch (JSDisconnectedException)
        {
            // The circuit is gone, and the module with it.
        }
    }

    // Each of these may move the selection (Follow mode keeps the newest visible row), so the right pane re-renders too.
    private Task OnFilter(ChangeEventArgs change)
    {
        List.Filter = change.Value as string ?? "";
        List.Refilter();
        return SelectedChanged.InvokeAsync();
    }

    private Task OnChangedOnly(ChangeEventArgs change)
    {
        List.ChangedOnly = change.Value is true;
        List.Refilter();
        return SelectedChanged.InvokeAsync();
    }

    private Task ShowAll()
    {
        List.ShowAll();
        return SelectedChanged.InvokeAsync();
    }

    private Task Resume()
    {
        List.Resume();
        return SelectedChanged.InvokeAsync();
    }

    private Task Select(long id)
    {
        List.Select(id);
        return SelectedChanged.InvokeAsync();
    }
}
