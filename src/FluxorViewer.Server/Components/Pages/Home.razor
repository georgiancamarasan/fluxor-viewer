@page "/"
@implements IDisposable
@inject SessionRegistry Registry

<PageTitle>Fluxor Viewer</PageTitle>

<div class="flex h-screen flex-col">
    <header class="flex flex-wrap items-center gap-4 border-b border-zinc-200 px-4 py-2 dark:border-zinc-800">
        <SessionPicker Sessions="sessions" Selected="selection.Selected" SelectedChanged="Select" />
        <FeaturePicker Features="features.Features" HasSession="selection.Selected is not null"
                       Selected="@features.Selected" SelectedChanged="SelectFeature" />
        <button class="control" disabled data-test="clear">Clear</button>
    </header>

    @if (sessions.Count == 0)
    {
        <Waiting />
    }
    else
    {
        <main class="flex min-h-0 flex-1">
            <section class="flex min-h-0 w-96 shrink-0 flex-col border-r border-zinc-200 dark:border-zinc-800">
                @if (selection.Selected is null)
                {
                    <div class="pane"><Placeholder Selected="false" /></div>
                }
                else
                {
                    <ActionListPane List="actions" HasFeature="features.Selected is not null" SelectedChanged="StateHasChanged" />
                }
            </section>
            <section class="pane flex-1">
                @if (selection.Selected is null)
                {
                    <Placeholder Selected="false" />
                }
                else
                {
                    <StatePane Feature="@features.Selected" Action="actions.Selected" Current="SelectedSession?.Current ?? []"
                               Toggles="TogglesFor(features.Selected)" />
                }
            </section>
        </main>
    }
</div>

@code {
    private readonly SessionSelection selection = new();
    private readonly FeatureSelection features = new();
    private readonly ActionList actions = new();
    private IReadOnlyList<ReceivedSession> sessions = [];

    // The State tab's expand/collapse choices, per Feature name for this Viewer tab.
    private readonly Dictionary<string, Dictionary<string, bool>> toggles = [];

    protected override void OnInitialized()
    {
        Refresh();
        Registry.Changed += OnChanged;
    }

    private void OnChanged(SessionChange change)
    {
        _ = InvokeAsync(() =>
        {
            // Actions in other Sessions don't matter here. For the selected one they're re-read: a Snapshot for a
            // still-connected Session raises no change of its own, and may have brought a different set of Features.
            if (change is EntriesAppended && change.SessionId != selection.Selected)
                return;
            Refresh();
            StateHasChanged();
        });
    }

    private void Refresh()
    {
        sessions = Registry.GetSessions();
        selection.Update(sessions);
        UpdateSelectedSession();
    }

    private void Select(Guid sessionId)
    {
        selection.Select(sessionId);
        selection.Update(sessions);
        UpdateSelectedSession();
    }

    private void SelectFeature(string featureName)
    {
        features.Select(featureName);
        UpdateSelectedSession();
    }

    private Dictionary<string, bool> TogglesFor(string? feature) =>
        feature is null ? [] : toggles.TryGetValue(feature, out var choices) ? choices : toggles[feature] = [];

    private ReceivedSession? SelectedSession => sessions.FirstOrDefault(s => s.SessionId == selection.Selected);

    /// <summary>Re-reads what depends on the selected Session: its Features, then its Actions against the Feature.</summary>
    private void UpdateSelectedSession()
    {
        var session = SelectedSession;
        features.Update(session?.Current.Keys ?? []);
        actions.Update(session, features.Selected);
    }

    public void Dispose() => Registry.Changed -= OnChanged;
}
