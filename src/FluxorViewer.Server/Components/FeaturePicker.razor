@* The toolbar's Feature picker for the selected Session. *@
<label class="flex items-center gap-2">
    <span class="toolbar-label">Feature</span>
    <select class="control" data-test="feature-picker" value="@Selected" @onchange="OnChange" disabled="@(Features.Count == 0)">
        @if (HasSession && Features.Count == 0)
        {
            <option value="" selected data-test="feature-option">No Features</option>
        }
        @foreach (var feature in Features)
        {
            <option value="@feature" data-test="feature-option">@feature</option>
        }
    </select>
</label>

@code {
    /// <summary>The selected Session's Feature names, already in display order.</summary>
    [Parameter, EditorRequired] public IReadOnlyList<string> Features { get; set; } = [];

    /// <summary>Whether a Session is selected, which tells "no Features" apart from "nothing to show".</summary>
    [Parameter] public bool HasSession { get; set; }

    /// <summary>The selected Feature's name, or null when there's none to select.</summary>
    [Parameter] public string? Selected { get; set; }

    /// <summary>The developer picked a Feature, by name.</summary>
    [Parameter] public EventCallback<string> SelectedChanged { get; set; }

    private Task OnChange(ChangeEventArgs change) =>
        change.Value is string { Length: > 0 } name ? SelectedChanged.InvokeAsync(name) : Task.CompletedTask;
}
