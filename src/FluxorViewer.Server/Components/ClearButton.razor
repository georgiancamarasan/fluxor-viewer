@* Clear, with its inline prompt: clears a connected Session's History or removes a disconnected Session. *@
@using System.Globalization

<ClearPrompt Name="clear" Label="Clear" Enabled="CanClear" Subject="Session?.SessionId"
             Question="@(Session is { } session ? Question(session) : "")" Confirmed="Confirm" />

@code {
    /// <summary>The selected Session, or null when none is.</summary>
    [Parameter] public ReceivedSession? Session { get; set; }

    /// <summary>The developer confirmed clearing this Session.</summary>
    [Parameter] public EventCallback<Guid> Cleared { get; set; }

    // A connected Session with an empty History has nothing to clear; a disconnected one can still be removed.
    private bool CanClear => Session is { } session && (session.Status == SessionStatus.Disconnected || session.History.Count > 0);

    // The prompt closes when another Session is selected, so this is the Session it asked about.
    private Task Confirm() => Session is { } session ? Cleared.InvokeAsync(session.SessionId) : Task.CompletedTask;

    /// <summary>Says what Clear will do given the status now: a disconnected Session goes, a connected one loses its History.</summary>
    private static string Question(ReceivedSession session)
    {
        var name = $"{session.AppName} · {session.ShortId}";
        if (session.Status == SessionStatus.Disconnected)
            return $"Remove disconnected Session {name}?";
        var count = session.Actions.Count();
        // A History of Resyncs alone has no Actions to count.
        if (count == 0)
            return $"Clear the History of {name}?";
        return $"Clear {count.ToString("N0", CultureInfo.InvariantCulture)} {(count == 1 ? "Action" : "Actions")} from {name}?";
    }
}
