@page "/counter"
@using System.Diagnostics
@inherits FluxorComponent
@inject IState<CounterState> State
@inject IDispatcher Dispatcher

<PageTitle>Counter</PageTitle>

<h1>Counter</h1>

<p role="status">Current count: @State.Value.Count</p>

<button class="btn btn-primary" @onclick="Increment">Increment</button>
<button class="btn btn-outline-primary" @onclick="Burst">Burst @BurstSize.ToString("N0") Actions</button>

@if (lastBurst is { } elapsed)
{
    <p class="mt-3">Last burst dispatched @BurstSize.ToString("N0") Actions in @elapsed.TotalMilliseconds.ToString("N0") ms.</p>
}

@code {
    private const int BurstSize = 5_000;
    private TimeSpan? lastBurst;

    private void Increment() => Dispatcher.Dispatch(new IncrementCounterAction());

    private void Burst()
    {
        var stopwatch = Stopwatch.StartNew();
        for (var i = 0; i < BurstSize; i++)
            Dispatcher.Dispatch(new IncrementCounterAction());
        lastBurst = stopwatch.Elapsed;
    }
}
