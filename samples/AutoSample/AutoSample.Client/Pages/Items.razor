@page "/items"
@inherits FluxorComponent
@inject IState<ItemsState> State
@inject IDispatcher Dispatcher

<PageTitle>Items</PageTitle>

<h1>Items</h1>

<p>The list is loaded by an Effect, which dispatches <code>ItemsLoadedAction</code> after a short delay.</p>

<button class="btn btn-primary" @onclick="Fetch" disabled="@State.Value.IsLoading">Load items</button>

@if (State.Value.IsLoading)
{
    <p class="mt-3"><em>Loading…</em></p>
}
else if (State.Value.Items.Count > 0)
{
    <ul class="mt-3">
        @foreach (var item in State.Value.Items)
        {
            <li>@item.Id. @item.Name</li>
        }
    </ul>
}

@code {
    private void Fetch() => Dispatcher.Dispatch(new FetchItemsAction());
}
