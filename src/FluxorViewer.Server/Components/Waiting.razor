@inject NavigationManager Navigation

<div class="mx-auto mt-16 max-w-2xl px-4" data-test="waiting">
    <p class="text-lg">Waiting for an app to connect…</p>
    <p class="muted mt-2">
        Add <code>UseFluxorViewer</code> to your existing <code>AddFluxor</code> call, then run the app.
        In an InteractiveAuto app, do this in both the server project and the <code>.Client</code> project,
        where it's <code>builder.HostEnvironment</code>.
    </p>
    <pre class="mt-4 overflow-x-auto rounded-md bg-zinc-100 p-4 font-mono text-sm dark:bg-zinc-900">@Snippet</pre>
</div>

@code {
    private string Snippet => $$"""
        // dotnet add package FluxorViewer.Middleware
        builder.Services.AddFluxor(o => o
            // ...your existing Fluxor setup...
            .UseFluxorViewer(v =>
            {
                v.Enabled = builder.Environment.IsDevelopment();
                v.ServerUrl = "{{Navigation.BaseUri.TrimEnd('/')}}";
            }));
        """;
}
