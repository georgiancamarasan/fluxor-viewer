@* JSON as an expandable tree, values exactly as received; says so instead of breaking when the JSON can't be read. *@
@using System.Text.Json
@implements IDisposable

@if (unreadable is not null)
{
    <p class="state-error" data-test="unreadable">Couldn't read this @Subject: @unreadable</p>
}
else
{
    <div class="json-tree" data-test="json-tree">
        @if (document is not null)
        {
            var root = document.RootElement;
            if (root.ValueKind is JsonValueKind.Object or JsonValueKind.Array)
            {
                @Children(root, Place.Root)
            }
            else
            {
                @Value(root, Place.Root.Path)
            }
        }
    </div>
}

@code {
    /// <summary>The JSON to show, left as received.</summary>
    [Parameter, EditorRequired] public string Json { get; set; } = "";

    /// <summary>What the JSON is, for the message when it can't be read: "state" or "Payload".</summary>
    [Parameter] public string Subject { get; set; } = "state";

    private string? parsed;
    private JsonDocument? document;

    // Why the JSON couldn't be read (too deep, or malformed by something other than the middleware). Shown instead of
    // throwing: an exception while rendering would end the developer's circuit.
    private string? unreadable;

    protected override void OnParametersSet()
    {
        if (Json == parsed)
            return;
        document?.Dispose();
        document = null;
        unreadable = null;
        parsed = Json;
        try
        {
            document = ReceivedJson.Parse(Json);
        }
        catch (JsonException ex)
        {
            unreadable = ex.Message;
        }
    }

    /// <summary>
    /// The developer's explicit expand/collapse choices by path (true = open); anything else follows the default. Owned by
    /// the caller so the choices outlive this JSON. Paths absent from this JSON are left alone.
    /// </summary>
    [Parameter] public Dictionary<string, bool> Toggles { get; set; } = [];

    /// <summary>Where a node sits: its JSON path (<c>$.a[0]</c>) and how deep it is (the root is 0).</summary>
    private readonly record struct Place(string Path, int Depth)
    {
        public static readonly Place Root = new("$", 0);

        /// <summary>A child of this node, one level deeper, at <paramref name="segment"/> (<c>.name</c> or <c>[3]</c>).</summary>
        public Place Child(string segment) => new(Path + segment, Depth + 1);
    }

    /// <summary>Array items from <paramref name="Start"/> up to, not including, <paramref name="End"/>.</summary>
    private readonly record struct ItemRange(int Start, int End)
    {
        /// <summary>The range's label and path segment, e.g. <c>[100…199]</c>.</summary>
        public string Label => $"[{Start}…{End - 1}]";
    }

    /// <summary>The root and its direct children are open unless toggled.</summary>
    private bool IsExpanded(Place place) => Toggles.TryGetValue(place.Path, out var expanded) ? expanded : place.Depth <= 1;

    private void Flip(string path, bool expanded) => Toggles[path] = !expanded;

    private RenderFragment Children(JsonElement element, Place place) => __builder =>
    {
        if (element.ValueKind == JsonValueKind.Object)
        {
            foreach (var property in element.EnumerateObject())
            {
                @Node(property.Name, property.Value, place.Child(Member(property.Name)))
            }
        }
        else if (element.ValueKind == JsonValueKind.Array)
        {
            var length = element.GetArrayLength();
            if (length <= RangeSize)
            {
                @Items(element, place, new ItemRange(0, length))
            }
            else
            {
                for (var start = 0; start < length; start += RangeSize)
                {
                    @Range(element, place, new ItemRange(start, Math.Min(start + RangeSize, length)))
                }
            }
        }
    };

    /// <summary>Longer arrays are split into ranges of this many items, so opening one doesn't render thousands of rows.</summary>
    private const int RangeSize = 100;

    private RenderFragment Items(JsonElement array, Place arrayPlace, ItemRange range) => __builder =>
    {
        var index = range.Start;
        foreach (var item in array.EnumerateArray().Skip(range.Start).Take(range.End - range.Start))
        {
            @Node(index.ToString(), item, arrayPlace.Child($"[{index}]"))
            index++;
        }
    };

    /// <summary>A range of array items. Ranges start collapsed and aren't a level: their items keep the array's depth + 1.</summary>
    private RenderFragment Range(JsonElement array, Place arrayPlace, ItemRange range) => __builder =>
    {
        var path = arrayPlace.Path + range.Label;
        var expanded = Toggles.GetValueOrDefault(path);
        <div class="json-node" data-test="node" data-path="@path">
            @Toggle(path, expanded)
            <span class="json-key" data-test="key">@range.Label</span>
            @if (expanded)
            {
                @Items(array, arrayPlace, range)
            }
        </div>
    };

    private RenderFragment Toggle(string path, bool expanded) => __builder =>
    {
        <button type="button" class="json-toggle" data-test="toggle" data-path="@path" aria-expanded="@(expanded ? "true" : "false")"
                aria-label="@(expanded ? "Collapse" : "Expand")" @onclick="() => Flip(path, expanded)">@(expanded ? "▾" : "▸")</button>
    };

    /// <summary>A scalar at <paramref name="path"/>, shown exactly as received.</summary>
    private static RenderFragment Value(JsonElement value, string path) => __builder =>
    {
        var kind = Kind(value.ValueKind);
        <span class="json-@kind" data-test="value" data-path="@path" data-kind="@kind">@value.GetRawText()</span>
    };

    /// <summary>A property's path segment: <c>.name</c> for identifiers, otherwise <c>["name"]</c> JSON-escaped.</summary>
    private static string Member(string name) =>
        name.Length > 0 && (char.IsLetter(name[0]) || name[0] is '_' or '$') && name.All(c => char.IsLetterOrDigit(c) || c is '_' or '$')
            ? "." + name
            : $"[{JsonSerializer.Serialize(name, Readable)}]";

    private static readonly JsonSerializerOptions Readable = new() { Encoder = System.Text.Encodings.Web.JavaScriptEncoder.UnsafeRelaxedJsonEscaping };

    private static string Kind(JsonValueKind kind) => kind switch
    {
        JsonValueKind.String => "string",
        JsonValueKind.Number => "number",
        JsonValueKind.True or JsonValueKind.False => "boolean",
        _ => "null",
    };

    /// <summary>What a collapsed object or array shows: <c>{…} 3 keys</c> or <c>[…] 1 item</c>.</summary>
    private static string Summary(JsonElement element) => element.ValueKind == JsonValueKind.Object
        ? "{…} " + Plural(element.EnumerateObject().Count(), "key")
        : "[…] " + Plural(element.GetArrayLength(), "item");

    private static string Plural(int count, string noun) => count == 1 ? $"1 {noun}" : $"{count} {noun}s";

    private RenderFragment Node(string key, JsonElement value, Place place) => __builder =>
    {
        var container = value.ValueKind is JsonValueKind.Object or JsonValueKind.Array;
        var expanded = container && IsExpanded(place);
        <div class="json-node" data-test="node" data-path="@place.Path">
            @if (container)
            {
                @Toggle(place.Path, expanded)
            }
            <span class="json-key" data-test="key">@key</span>:
            @if (!container)
            {
                @Value(value, place.Path)
            }
            @if (container && !expanded)
            {
                <span class="json-summary" data-test="summary" data-path="@place.Path">@Summary(value)</span>
            }
            @if (expanded)
            {
                @Children(value, place)
            }
        </div>
    };

    /// <summary>Releases the parsed JSON.</summary>
    public void Dispose() => document?.Dispose();
}
