@implements IAsyncDisposable
@inject IJSRuntime JS

@switch (diff)
{
    case null:
        break;
    case FeatureDiff.NoAction:
        <p class="muted" data-test="diff-message">Select an Action to see what it changed</p>
        break;
    case FeatureDiff.Unavailable:
        <p class="muted" data-test="diff-message">History was lost before this point; diff unavailable</p>
        break;
    case FeatureDiff.Missing:
        <p class="muted" data-test="diff-message">@Feature didn't exist at this point</p>
        break;
    default:
        <div class="flex min-h-0 flex-col" data-test="diff">
            <div class="mb-3 flex items-center gap-3 text-sm text-zinc-500 dark:text-zinc-400">
                <p class="min-w-0 flex-1" data-test="diff-header">
                    <span class="font-mono" title="@stateType">@ActionTypeName.Short(stateType!)</span> ·
                    #@Action!.Sequence <span class="font-mono" title="@Action.ActionType">@ActionTypeName.Short(Action.ActionType)</span>
                    · before → after
                </p>
                @if (diff is FeatureDiff.Changes && hasDifference)
                {
                    <label class="flex shrink-0 items-center gap-1.5">
                        <input type="checkbox" data-test="show-unchanged" checked="@ShowUnchanged" @onchange="OnShowUnchanged" />
                        Show unchanged
                    </label>
                }
            </div>
            @switch (diff)
            {
                case FeatureDiff.NoChange:
                    <p class="muted" data-test="diff-message">No change to @Feature</p>
                    break;
                case FeatureDiff.Identical:
                    <p class="muted" data-test="diff-message">@Feature was replaced with an identical state</p>
                    break;
                case FeatureDiff.Error error:
                    <p class="rounded-md border border-red-300 bg-red-50 px-3 py-2 font-mono text-sm text-red-700 dark:border-red-800 dark:bg-red-950/50 dark:text-red-300"
                       data-test="diff-error">Couldn't serialise @Feature @error.Side this Action: @error.Message</p>
                    break;
                case FeatureDiff.Changes:
                    @if (!hasDifference)
                    {
                        <p class="muted" data-test="diff-message">@Feature was replaced; the differences are beyond what the diff can show</p>
                    }
                    @* Filled by DiffPane.razor.js; Blazor never renders into it. *@
                    <div class="json-diff" data-test="diff-view" @ref="host"></div>
                    break;
            }
        </div>
        break;
}

@code {
    /// <summary>The selected Feature's name; the pane shows nothing without one.</summary>
    [Parameter] public string? Feature { get; set; }

    /// <summary>The selected Action or Resync, or null when none is.</summary>
    [Parameter] public HistoryEntry? Entry { get; set; }

    private ActionEntry? Action => Entry as ActionEntry;

    /// <summary>Whether unchanged values show; kept by the caller for the Viewer tab.</summary>
    [Parameter] public bool ShowUnchanged { get; set; }

    [Parameter] public EventCallback<bool> ShowUnchangedChanged { get; set; }

    private FeatureDiff? diff;
    private string? stateType;
    private ElementReference host;
    private IJSObjectReference? module;

    // What the browser last diffed; it diffs again only when one of these changes, not on every render.
    private (ActionEntry? Action, string? Feature, bool ShowUnchanged) rendered;

    // Whether the browser found a difference in the JSON last diffed; it can't when numbers differ only beyond 2^53.
    private bool hasDifference = true;

    protected override void OnParametersSet()
    {
        diff = Feature is null ? null : FeatureDiff.For(Entry, Feature);
        stateType = Feature is null ? null : (Action?.After.GetValueOrDefault(Feature) ?? Action?.Before.GetValueOrDefault(Feature))?.StateType;
        if (diff is not FeatureDiff.Changes)
            rendered = default;
        // Until the browser says otherwise, a new before → after is assumed to differ, so a stale message doesn't linger.
        if (!ReferenceEquals(rendered.Action, Action) || rendered.Feature != Feature)
            hasDifference = true;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (diff is not FeatureDiff.Changes changes)
            return;
        var requested = (Action, Feature, ShowUnchanged);
        if (Same(rendered, requested))
            return;
        rendered = requested;
        module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./Components/DiffPane.razor.js");
        var found = await module.InvokeAsync<bool>("render", host, changes.Before, changes.After, ShowUnchanged);
        // Follow mode may have moved on while the browser was diffing; that later diff decides.
        if (Same(rendered, requested) && found != hasDifference)
        {
            hasDifference = found;
            StateHasChanged();
        }
    }

    // By reference: an ActionEntry is a record, and comparing its JSON by value would cost as much as a diff.
    private static bool Same((ActionEntry? Action, string? Feature, bool ShowUnchanged) a, (ActionEntry? Action, string? Feature, bool ShowUnchanged) b) =>
        ReferenceEquals(a.Action, b.Action) && a.Feature == b.Feature && a.ShowUnchanged == b.ShowUnchanged;

    private Task OnShowUnchanged(ChangeEventArgs e) => ShowUnchangedChanged.InvokeAsync(e.Value is true);

    public async ValueTask DisposeAsync()
    {
        try
        {
            if (module is not null)
                await module.DisposeAsync();
        }
        catch (JSDisconnectedException)
        {
            // The circuit is gone, and the module with it.
        }
    }
}
